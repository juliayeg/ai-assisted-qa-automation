# =============================================================================
# Run tests (required to clone and run Playwright)
# Copy this file to `.env` and fill in real values. Do not commit `.env`.
# =============================================================================

# Base URL of the Didaxis app under test (no trailing slash).
DIDAXIS_URL=https://your-didaxis-host.example

# Primary UI login used by tests/auth.setup.ts and storageState.
DIDAXIS_EMAIL=your-account@example.com
DIDAXIS_PASSWORD=your-ui-password-here

# Bearer token for API cleanup (programs bulk delete in fixtures). Refresh when 401.
# Leave empty locally if cleanup can use the token captured during UI login.
DIDAXIS_API_TOKEN=

# Optional: second account for permission / role probes (not used unless referenced in a spec).
DIDAXIS_ALT_EMAIL=alt-account@example.com
DIDAXIS_ALT_PASSWORD=alt-ui-password-here

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# Set as GitHub Actions secrets for workflows under .github/workflows/.
# For local Cursor agents, also configure Atlassian MCP in Cursor settings.
# =============================================================================

# Cursor CLI (`agent -p`) in test-generation.yml and e2e self-heal job.
CURSOR_API_KEY=your-cursor-api-key-here

# Jira API token (https://id.atlassian.com/manage-profile/security/api-tokens).
ATLASSIAN_API_TOKEN=your-atlassian-api-token-here

# Jira Cloud site URL, e.g. https://your-site.atlassian.net
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN for Jira MCP / agent.
ATLASSIAN_EMAIL=your-atlassian-account@example.com
